From 7d04df5de28278716a32e610f86b821d14a9cfe0 Mon Sep 17 00:00:00 2001
From: gaurav2361 <gaurav23617@gmail.com>
Date: Mon, 27 Apr 2026 12:21:47 +0530
Subject: [PATCH] Fix Zig ArrayList syntax for 0.16.0

---
 src/main.zig | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/main.zig b/src/main.zig
index 46bbe8e..a2d370e 100644
--- a/src/main.zig
+++ b/src/main.zig
@@ -4227,15 +4227,15 @@ fn runMigrate(alloc: std.mem.Allocator) void {
                 };
                 defer cask_meta.deinit(alloc);
 
-                var apps = std.ArrayList([]const u8).init(alloc);
+                var apps: std.ArrayList([]const u8) = .empty;
                 defer {
                     for (apps.items) |a| alloc.free(a);
-                    apps.deinit();
+                    apps.deinit(alloc);
                 }
-                var bins = std.ArrayList([]const u8).init(alloc);
+                var bins: std.ArrayList([]const u8) = .empty;
                 defer {
                     for (bins.items) |b| alloc.free(b);
-                    bins.deinit();
+                    bins.deinit(alloc);
                 }
 
                 for (cask_meta.artifacts) |art| {
